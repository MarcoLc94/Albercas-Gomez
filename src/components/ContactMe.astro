---
---

<section class="contact-section" id="contact">
  <div class="contact-inner">
    <div class="contact-info">
      <span class="eyebrow">Contacto</span>
      <h1>Hablemos de tu alberca</h1>
      <p>
        Cuéntanos tu idea y recibe un presupuesto detallado y sin compromiso.
        También puedes escribirnos o llamarnos directamente.
      </p>

      <ul class="channels">
        <li>
          <a href="tel:8128595397">
            <span class="channel-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/>
              </svg>
            </span>
            <span class="channel-text">
              <small>Llámanos</small>
              <strong>8128595397</strong>
            </span>
          </a>
        </li>
        <li>
          <a href="https://wa.me/8128595397?text=Hola,%20vengo%20de%20tu%20página%20web%20me%20interesa%20un%20presupuesto." target="_blank" rel="noopener noreferrer">
            <span class="channel-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-5A8.5 8.5 0 1 1 21 11.5z"/>
              </svg>
            </span>
            <span class="channel-text">
              <small>WhatsApp</small>
              <strong>Escríbenos</strong>
            </span>
          </a>
        </li>
      </ul>
    </div>

    <form class="contact-form" action="https://formspree.io/f/xyzgpjby" method="POST" enctype="multipart/form-data">
      <h2>Solicita tu presupuesto</h2>

      <label for="name">Nombre</label>
      <input type="text" id="name" name="name" placeholder="Tu nombre" autocomplete="name" required />

      <label for="phone">Teléfono</label>
      <input type="tel" id="phone" name="phone" placeholder="Tu número de contacto" autocomplete="tel" required />

      <label for="message">Mensaje</label>
      <textarea id="message" name="message" rows="5" placeholder="¿Qué tipo de alberca tienes en mente?" required></textarea>

      <input type="hidden" name="_next" value="/thanks">
      <button type="submit">Enviar mensaje</button>
    </form>
  </div>
</section>

<style>
  .contact-section {
    --gold: #c9a961;
    --navy-deep: #070d18;
    --navy: #101a2e;
    --muted: #a3acbb;

    position: relative;
    overflow: hidden;
    padding: 90px 24px;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: #f1f3f7;
    background:
      radial-gradient(60% 70% at 15% 10%, rgba(201, 169, 97, 0.1), transparent 70%),
      radial-gradient(50% 60% at 90% 100%, rgba(45, 90, 160, 0.22), transparent 70%),
      linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  .contact-inner > * {
    min-width: 0;
  }

  /* Columna de información */
  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .contact-info h1 {
    margin: 0 0 16px;
    font-size: clamp(2rem, 4.2vw, 2.9rem);
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
  }

  .contact-info p {
    max-width: 44ch;
    margin: 0 0 32px;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 340px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .channels a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .channels a:hover {
    background: rgba(201, 169, 97, 0.08);
    border-color: rgba(201, 169, 97, 0.55);
    transform: translateX(4px);
  }

  .channel-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: var(--gold);
    background: rgba(201, 169, 97, 0.12);
    border-radius: 10px;
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .channel-text small {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .channel-text strong {
    font-size: 1.02rem;
    font-weight: 600;
    color: #fff;
  }

  /* Formulario */
  .contact-form {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 36px;
    color: #17233a;
    background: #f8f6f0;
    border-top: 3px solid var(--gold);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .contact-form h2 {
    margin: 0 0 22px;
    font-size: 1.3rem;
    font-weight: 700;
    color: #101a2e;
  }

  .contact-form label {
    margin-bottom: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #33415c;
  }

  .contact-form input:not([type='hidden']),
  .contact-form textarea {
    margin-bottom: 18px;
    padding: 12px 14px;
    font: inherit;
    font-size: 16px;
    color: #17233a;
    background: #fff;
    border: 1px solid #d9d4c7;
    border-radius: 10px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #9aa3b2;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201, 169, 97, 0.28);
  }

  .contact-form button {
    padding: 14px 20px;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: #101a2e;
    background: var(--gold);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-form button:hover {
    background: #d8bb76;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(201, 169, 97, 0.35);
  }

  .contact-form button:active {
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .contact-section {
      padding: 64px 20px;
    }

    .contact-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .channels {
      max-width: none;
    }

    .contact-form {
      padding: 28px 22px;
    }
  }
</style>
