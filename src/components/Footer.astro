---
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <span class="footer-name">Albercas Gómez</span>
            <p>Construimos tu alberca como te la imaginas.</p>
        </div>

        <nav class="footer-col" aria-label="Enlaces del pie de página">
            <h4>Navegación</h4>
            <a href="#home">Inicio</a>
            <a href="#gallery">Galería</a>
            <a href="#contact">Contacto</a>
        </nav>

        <div class="footer-col">
            <h4>Contacto</h4>
            <a href="tel:8128595397">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/>
                </svg>
                8128595397
            </a>
            <a href="https://wa.me/8128595397?text=Hola,%20vengo%20de%20tu%20página%20web%20me%20interesa%20un%20presupuesto." target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-5A8.5 8.5 0 1 1 21 11.5z"/>
                </svg>
                WhatsApp
            </a>
        </div>
    </div>

    <div class="footer-bottom">
        <p>© {year} Construcciones Gómez. Todos los derechos reservados.</p>
    </div>
</footer>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Nunito:wght@400;600;700&display=swap');

    .site-footer {
        --navy: #17233a;
        --gold: #c9a961;
        --gold-text: #8a6d23;
        --muted: #5b6577;

        background: #fff;
        border-top: 3px solid var(--gold);
        color: var(--navy);
        font-family: 'Nunito', system-ui, -apple-system, 'Segoe UI', sans-serif;
    }

    .footer-inner {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 40px;
        max-width: 1080px;
        margin: 0 auto;
        padding: 52px 24px 40px;
    }

    .footer-name {
        display: inline-block;
        color: var(--navy);
        font-family: 'Cinzel', serif;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    /* Filete dorado bajo el nombre */
    .footer-name::after {
        content: '';
        display: block;
        width: 44px;
        height: 2px;
        margin-top: 10px;
        background: var(--gold);
    }

    .footer-brand p {
        max-width: 44ch;
        margin-top: 14px;
        color: var(--muted);
        font-size: 0.98rem;
        line-height: 1.6;
    }

    .footer-col {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .footer-col h4 {
        margin-bottom: 4px;
        color: var(--gold-text);
        font-family: 'Cinzel', serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .footer-col a {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--navy);
        font-size: 0.98rem;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .footer-col a:hover {
        color: var(--gold-text);
        transform: translateX(3px);
    }

    .footer-col a svg {
        flex: none;
        color: var(--gold-text);
    }

    .footer-bottom {
        padding: 18px 24px;
        text-align: center;
        border-top: 1px solid rgba(23, 35, 58, 0.1);
    }

    .footer-bottom p {
        color: var(--muted);
        font-size: 0.85rem;
    }

    @media (max-width: 700px) {
        .footer-inner {
            grid-template-columns: 1fr;
            gap: 32px;
            padding: 40px 24px 28px;
            text-align: center;
        }

        .footer-brand p {
            margin-inline: auto;
        }

        .footer-name::after {
            margin-inline: auto;
        }

        .footer-col {
            align-items: center;
        }
    }
</style>
